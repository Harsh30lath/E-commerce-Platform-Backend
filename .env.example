# ================================
# DATABASE CONFIGURATION
# ================================

# MongoDB Connection URL
MONGODB=your_mongodb_connection_url


# ================================
# JWT AUTHENTICATION
# ================================

# JWT Access Token Secret
ACCESSTOKEN=your_jwt_access_token_secret


# ================================
# RAZORPAY CONFIGURATION
# ================================

# Razorpay Public API Key
RAZORPAY_API_KEY=your_razorpay_api_key

# Razorpay Private Secret Key
RAZORPAY_SECRET_KEY=your_razorpay_secret_key

# Razorpay Webhook Secret
RAZORPAY_WEBHOOK_KEY=your_razorpay_webhook_secret


# ================================
# SERVER CONFIGURATION
# ================================

# Server Port
PORT=5000


# ================================
# EMAIL CONFIGURATION
# ================================

# Gmail Address
EMAIL_USER=your_email@gmail.com

# Gmail App Password (16-digit)
EMAIL_PASS=your_16_digit_app_password


# ================================
# AWS S3 CONFIGURATION
# ================================

# AWS S3 Bucket Name
BUCKET_NAME=your_bucket_name

# AWS Region
AWS_REGION=ap-south-1

# AWS IAM Access Key ID
ACCESS_KEY_ID=your_aws_access_key_id

# AWS IAM Secret Access Key
ACCESS_KEY_PASS=your_aws_secret_access_key